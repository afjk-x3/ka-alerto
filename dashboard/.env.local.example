# Server-only (no NEXT_PUBLIC_): read by src/app/api/events/route.ts, never sent to the browser.
# Same project and anon key the Android app uses (sync/SupabaseConfig.kt).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The shared PIN officials enter. Leave unset for dev mode (no PIN asked).
DASHBOARD_PIN=1234
