<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Lint suggests merging mipmap-anydpi-v26 into mipmap-anydpi because minSdk is 26.
         Doing so makes AAPT2 fail to resolve @mipmap/ic_launcher at link time
         ("resource mipmap/ic_launcher not found"), so the -v26 qualifier stays. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>

    <!-- Timber arrives transitively via MapLibre and ships its own lint check telling us
         to use it instead of android.util.Log. We do not depend on Timber directly and
         are not adding a logging library to satisfy a check from one we never chose. -->
    <issue id="LogNotTimber" severity="ignore" />
</lint>
