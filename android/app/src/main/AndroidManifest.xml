<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Bluetooth & Nearby Connections -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Nearby Connections brings up its own Wi-Fi Direct / hotspot legs to upgrade a
         bandwidth-limited Bluetooth connection, so it needs these two even though the
         app never touches Wi-Fi itself. Both are install-time, so nothing is prompted
         for. Omitting them does not fail at build or install time — startAdvertising()
         fails at runtime with MISSING_PERMISSION_CHANGE_WIFI_STATE (8033), which is how
         this was found on the API 34 emulator. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Every transport is optional: the app's claim is that it still works when each
         one is unavailable. Nothing here may be android:required="true". -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Day 9's nearby-SOS alert. Since API 34 this is auto-granted only to calling and
         alarm apps; for everyone else the user grants it in settings, and
         NotificationManager.canUseFullScreenIntent() says which side we are on. The
         alert degrades to a max-priority heads-up when it is not held — see
         sos/SosAlertNotifier.kt. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Family-circle QR pairing only (build day 11a) — the app's first camera use.
         required="false" for the same reason every other uses-feature here is: no
         transport or capability may block an install. Added on Task 6, not Task 5 that
         introduced the permission — lint's PermissionImpliesUnsupportedChromeOsHardware
         only surfaces once something actually builds against this permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".KaAlertoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_schemes"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaAlerto">

        <!-- singleTop so tapping day 9's nearby-SOS alert reaches onNewIntent on the
             already-running activity. With the default "standard" mode a tap on an
             app that is already open resumes it without any callback at all, so the
             alert's whole point — landing on the request it was about — silently does
             nothing. Found by tapping it on the emulator. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.KaAlerto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nearby Connections mesh. Not exported: nothing outside this app may start
             or stop the relay, and the only legitimate starter is MapScreen once the
             Bluetooth/Wi-Fi/location runtime permissions are actually held. -->
        <service
            android:name=".mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- zxing-android-embedded's own bundled manifest declares this same activity as
             android:screenOrientation="sensorLandscape" (see zxing-android-embedded-4.3.0.aar).
             Redeclaring it here with the same name overrides that one attribute — the app
             manifest wins during merge — without needing a custom CaptureActivity subclass.
             Portrait matches how every other screen in this app is held; the square
             viewfinder itself is a layout-resource override, not a manifest one — see
             res/layout/zxing_capture.xml. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:replace="android:screenOrientation" />

        <!-- SMS Receiver -->
        <receiver
            android:name=".broadcast.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
