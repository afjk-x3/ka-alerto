<?xml version="1.0" encoding="utf-8"?>
<!-- The event store is a replica that rebuilds from peers, so nothing here needs to
     survive a device transfer. Excluding it also keeps reporter names off backup media. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
