# core.autocrlf is true on the dev machine, which would rewrite gradlew with CRLF
# and break it on any Unix shell ("bad interpreter: /bin/sh^M"). Pin the endings.
gradlew        text eol=lf
gradlew.bat    text eol=crlf
*.sh           text eol=lf

# Binaries — never line-ending converted, never diffed as text.
*.jar          binary
*.png          binary
*.jpg          binary
*.docx         binary
*.pdf          binary
*.apk          binary
*.aab          binary
*.keystore     binary
*.jks          binary

# Map fixtures (arriving with the seed data).
*.mbtiles      binary
*.pbf          binary
